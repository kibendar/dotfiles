//  https://github.com/m3tozz/FastCat

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
    },
    "break",
    {
      "type": "os",
      "key": " ",
    },
    {
      "type": "kernel",
      "key": " ",
    },
    {
      "type": "shell",
      "key": " ",
    },
    {
      "type": "terminal",
      "key": " ",
    },
    {
      "type": "uptime",
      "key": " ",
    },
    {
      "type": "cpu",
      "key": "󰻠 ",
      "showPeCoreCount": true,
      "temp": true,
    },
    {
      "type": "disk",
      "key": "󰋊 ",
    },
    {
      "type": "memory",
      "key": "󰾆 ",
    },
    "break",
    "colors",
    "break",
    "break",
  ],
}
